# ══════════════════════════════════════════════
#  Copiá este archivo como .env.local y completá
#  los valores reales. NUNCA subas .env.local a Git.
# ══════════════════════════════════════════════

# URL base del BFF NestJS (Backend For Frontend)
NEXT_PUBLIC_CORE_URL=http://localhost:4101/worldCupCore

# Código ISO de 3 letras del equipo por defecto (ej: arg, bra, esp)
NEXT_PUBLIC_TEAM_ID=arg

# Idioma por defecto de las respuestas de la API (es / en)
NEXT_PUBLIC_APP_LANG=es

# Puerto del servidor Next.js
PORT=3101
